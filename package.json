{
  "name": "ewiz-monorepo",
  "private": true,
  "packageManager": "bun@1.2.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@ewiz/web",
    "build": "turbo run build",
    "build:macos": "turbo run build --filter=ewiz",
    "build:web": "turbo run build --filter=@ewiz/web",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "changeset": "changeset",
    "version": "changeset version",
    "prepare": "husky",
    "secrets:backup": "./scripts/secrets.sh backup",
    "secrets:restore": "./scripts/secrets.sh restore",
    "secrets:check": "./scripts/secrets.sh check",
    "secrets:push:web": "./scripts/secrets.sh push web",
    "secrets:push:release": "./scripts/secrets.sh push release"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "turbo": "^2.5.0"
  }
}
